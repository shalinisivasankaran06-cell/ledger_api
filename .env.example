# Copy to .env and adjust. Every value can also be set as a normal environment variable.

# SQLAlchemy URL for the app (postgresql+psycopg = PostgreSQL via the psycopg 3 driver)
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledger

# Separate, disposable database used by the test suite (tables are dropped/re-created)
TEST_DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/ledger_test

# GET /accounts/{id}/transactions defaults
DEFAULT_PAGE_SIZE=10
MAX_PAGE_SIZE=100

# Log every SQL statement (true/false)
SQL_ECHO=false
